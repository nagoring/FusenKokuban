{
  "name": "fusenkokuban",
  "version": "0.2.0",
  "description": "黒板に付箋を貼るデスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.js",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagoring/FusenKokuban.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nagoring/FusenKokuban/issues"
  },
  "homepage": "https://github.com/nagoring/FusenKokuban#readme",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "productName": "FusenKokuban",
  "build": {
    "appId": "com.nagoring.fusenkokuban",
    "productName": "FusenKokuban",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      },
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
